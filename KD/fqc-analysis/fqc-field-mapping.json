{
  "description": "FQC Excel 欄位與系統資料模型對應定義",
  "excelSheet": "產品資料",
  "mappings": [
    {
      "colIndex": 0,
      "header": "產品類別\nLoại sản phẩm",
      "modelField": "category",
      "mergeGroup": true,
      "note": "垂直合併分組，向後繼承"
    },
    {
      "colIndex": 1,
      "header": "錯誤代碼 Mã lỗi",
      "modelField": "errorCode",
      "mergeGroup": true,
      "note": "垂直合併分組，代碼不可連帶刪除"
    },
    {
      "colIndex": 2,
      "header": "錯誤代碼名稱 Tên mã lỗi",
      "modelField": "errorName",
      "mergeGroup": true,
      "note": "垂直合併分組"
    },
    {
      "colIndex": 3,
      "header": "FQC檢查編號\nMã kiểm tra FQC",
      "modelField": "checkNo",
      "mergeGroup": false,
      "note": "每列唯一，格式 <類別前綴>-FQC-L<L號>-<2位序號>"
    },
    {
      "colIndex": 4,
      "header": "檢查項目\nHạng mục kiểm tra",
      "modelField": "checkItemName",
      "mergeGroup": false,
      "note": "越文原文保留"
    },
    {
      "colIndex": 5,
      "header": "檢查方式敘述 Mô tả các phương pháp kiểm tra",
      "modelField": "checkDesc",
      "mergeGroup": false,
      "note": "來源目前全空白，保留欄位"
    },
    {
      "colIndex": 6,
      "header": "檢查方式圖片 Hình ảnh phương pháp kiểm tra",
      "modelField": "checkPhotos",
      "mergeGroup": false,
      "note": "來源目前無內嵌圖片，保留關聯結構"
    },
    {
      "colIndex": 7,
      "header": "檢查工具(照片)\nCông cụ kiểm tra (Photo)",
      "modelField": "tool",
      "mergeGroup": false,
      "note": "越文原文保留，不另建工具管理"
    },
    {
      "colIndex": 8,
      "header": "是否加入季檢查列表\nCó đưa vào danh sách kiểm tra hàng quý không",
      "modelField": "isQuarterly",
      "mergeGroup": false,
      "note": "YES/NO 轉為布林值"
    },
    {
      "colIndex": 9,
      "header": "包含產品\nSản phẩm áp dụng",
      "modelField": "productCodes",
      "mergeGroup": false,
      "note": "逗號分隔字串轉為字串陣列"
    },
    {
      "colIndex": 10,
      "header": "是否啟用\nCó kích hoạt không",
      "modelField": "isEnabled",
      "mergeGroup": false,
      "note": "YES/NO 轉為布林值，預設啟用"
    },
    {
      "colIndex": 11,
      "header": "版本\nPhiên bản",
      "modelField": "version",
      "mergeGroup": false,
      "note": "來源固定 V1.0"
    },
    {
      "colIndex": 12,
      "header": "版本變更時間 Thời gian thay đổi phiên bản",
      "modelField": "versionDate",
      "mergeGroup": false,
      "note": "Excel 數值 46283 -> 2026-09-18"
    },
    {
      "colIndex": 13,
      "header": "版本變更原因Lý do thay đổi phiên bản",
      "modelField": "versionReason",
      "mergeGroup": false,
      "note": "來源為 Mới thành lập"
    },
    {
      "colIndex": 14,
      "header": "Người tạo\n建立者",
      "modelField": "creator",
      "mergeGroup": false,
      "note": "來源全空白，系統由當前登入者帶入"
    },
    {
      "colIndex": 15,
      "header": "備註 GHI CHÚ",
      "modelField": "note",
      "mergeGroup": false,
      "note": "選填字串"
    },
    {
      "colIndex": 16,
      "header": "未建立產品 Chưa có sản phẩm nào được thành lập.",
      "modelField": "_unestablishedProducts",
      "mergeGroup": true,
      "note": "來源全空白"
    },
    {
      "colIndex": 17,
      "header": "FQC錯誤代碼使用比例 Tỷ lệ sử dụng mã lỗi FQC",
      "modelField": "_usageRatioFormula",
      "mergeGroup": true,
      "note": "說明文字，不寫入主業務實體"
    }
  ],
  "systemGeneratedFields": [
    {
      "field": "isMonthly",
      "default": false,
      "note": "Excel 中無此欄位，依規格預設未勾"
    },
    {
      "field": "draftReason",
      "default": "",
      "note": "草稿變更理由，每次儲存變動時依規格記錄"
    }
  ]
}